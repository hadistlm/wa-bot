GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=300

PERSONA_NAME=Your Name
# Path to a Markdown persona file. Takes priority over PERSONA_PROMPT.
PERSONA_FILE=persona.md
PERSONA_PROMPT=

# Comma-separated: names, phone numbers (any format), or globs like *Santoso*.
# Add :work or :friend to set the relationship, for example Budi:work
ALLOWED_CHATS=
ALLOW_GROUPS=false
MATCH_THRESHOLD=0.85

CONTEXT_MESSAGES=5
SKIP_TRIVIAL=true
DEBOUNCE=true
MAX_REPLIES_PER_HOUR=20
POLL_INTERVAL=4
REPLY_DELAY_MIN=2
REPLY_DELAY_MAX=6
# Silent window, 24h clock. Empty disables it. Crossing midnight is fine.
QUIET_HOURS=23:00-07:00
# Chance per incoming message that the bot goes AFK for a random spell. 0 disables it.
AFK_CHANCE=0.1
AFK_MIN_MINUTES=3
AFK_MAX_MINUTES=20
# Let Gemini mention the delay after a long spell, for example "sori baru bales".
AFK_ACKNOWLEDGE=false
AFK_ACK_MIN_MINUTES=5
# Ignore messages that were already waiting when the bot started.
SKIP_BACKLOG=true
# Typing speed per character and the longest the bot may spend typing one reply.
TYPING_CHAR_DELAY_MS=70
MAX_TYPING_SECONDS=20
DB_PATH=wabot.db
PROFILE_DIR=.wa-profile
BROWSER_CHANNEL=
