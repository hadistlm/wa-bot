GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.8
GEMINI_MAX_OUTPUT_TOKENS=300

PERSONA_NAME=Your Name
# Name WhatsApp shows on your own messages. The bot also learns it by itself. Comma-separated.
OWN_NAMES=
# Path to a Markdown persona file. Takes priority over PERSONA_PROMPT.
PERSONA_FILE=persona.md
PERSONA_PROMPT=

# Comma-separated: names, phone numbers (any format), or globs like *Santoso*.
# Add :work, :friend, :lover or :family to set the relationship, for example Budi:work
ALLOWED_CHATS=
ALLOW_GROUPS=false
MATCH_THRESHOLD=0.85

CONTEXT_MESSAGES=5
SKIP_TRIVIAL=true
DEBOUNCE=true
MAX_REPLIES_PER_HOUR=20
POLL_INTERVAL=4
# Thinking pause after Gemini answers and before the first key. Reading time for the
# sender's message (READ_SECONDS_PER_WORD) is added on top.
REPLY_DELAY_MIN=4
REPLY_DELAY_MAX=12
READ_SECONDS_PER_WORD=0.25
# Silent window, 24h clock. Empty disables it. Crossing midnight is fine.
QUIET_HOURS=23:00-07:00
# Chance per incoming message that the bot goes AFK for a random spell. 0 disables it.
AFK_CHANCE=0.1
AFK_MIN_MINUTES=3
AFK_MAX_MINUTES=20
# Let Gemini mention the delay after a long spell, for example "sori baru bales".
AFK_ACKNOWLEDGE=false
AFK_ACK_MIN_MINUTES=5
# Ignore messages that were already waiting when the bot started.
SKIP_BACKLOG=true
# Typing like a person: average pause per key, how uneven it is (0 to 1), and the longest
# the bot may spend typing one reply. 0 for the delay pastes the reply instantly.
TYPING_CHAR_DELAY_MS=200
TYPING_JITTER=0.4
MAX_TYPING_SECONDS=30
# list: stay on the chat list and open only allowed chats that need an answer.
# open: answer whichever chat is open in the window.
WATCH_MODE=list
OPEN_DELAY_MIN=1
OPEN_DELAY_MAX=4
# Minimum pause between answers to different chats, so two messages that arrive
# together are answered one by one.
REPLY_GAP_MIN=15
REPLY_GAP_MAX=45
# Minutes between "still watching" lines in the terminal. 0 turns them off.
HEARTBEAT_MINUTES=5
# Show what the sender wrote in the terminal. false logs only counts.
LOG_MESSAGES=true
# Chromium sandbox. Keep true to avoid the "unsupported --no-sandbox" banner.
CHROMIUM_SANDBOX=true
# No browser window. Flakier and easier to detect. Ignored by --login.
HEADLESS=false
# All bot data lives in data/: history, saved login, page dumps.
DB_PATH=data/wabot.db
PROFILE_DIR=data/profile
BROWSER_CHANNEL=
